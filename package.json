{
  "name": "vedionoter",
  "version": "1.0.0",
  "private": true,
  "description": "vedioNoter 跨平台桌面客户端与核心引擎 (Win & Mac)",
  "scripts": {
    "desktop": "cd desktop && npm start",
    "desktop:dev": "cd desktop && npm run dev",
    "build:exe": "cd desktop && node build.cjs",
    "build:installer": "cd desktop && npx electron-builder --win --x64",
    "build:installer:mac": "cd desktop && npx electron-builder --mac",
    "build:frontend": "cd web/frontend && npm run build"
  }
}
