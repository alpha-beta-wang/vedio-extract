{
  "name": "vedionoter-desktop",
  "productName": "vedioNoter",
  "appId": "com.vedionoter.app",
  "version": "1.1.0",
  "description": "vedioNoter 视频转文字与 AI 学习笔记桌面客户端 (Win & Mac)",
  "main": "main.cjs",
  "author": "vedioNoter",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build:exe": "node build.cjs",
    "dist:installer": "electron-builder --win --x64 --publish never",
    "dist:mac": "electron-builder --mac --publish never"
  },
  "build": {
    "appId": "com.vedionoter.app",
    "productName": "vedioNoter",
    "directories": {
      "output": "../release"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "pythonManager.cjs",
      "startup.html",
      "package.json",
      "icons/**/*"
    ],
    "extraResources": [
      {
        "from": "../dist/vedionoter-engine",
        "to": "engine"
      },
      {
        "from": "../web/frontend/dist",
        "to": "web/frontend/dist"
      },
      {
        "from": "../web/backend",
        "to": "web/backend"
      },
      {
        "from": "../summarizer",
        "to": "summarizer"
      },
      {
        "from": "../config.py",
        "to": "config.py"
      },
      {
        "from": "../config.example.yaml",
        "to": "config.example.yaml"
      },
      {
        "from": "../transcribe.py",
        "to": "transcribe.py"
      },
      {
        "from": "../summarize.py",
        "to": "summarize.py"
      },
      {
        "from": "../run_all.py",
        "to": "run_all.py"
      },
      {
        "from": "../requirements.txt",
        "to": "requirements.txt"
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "icons/icon.png",
      "category": "public.app-category.productivity",
      "artifactName": "vedioNoter-${version}-mac.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icons/icon.ico",
      "artifactName": "vedioNoter-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "vedioNoter",
      "installerIcon": "icons/icon.ico",
      "uninstallerIcon": "icons/icon.ico",
      "runAfterFinish": true
    }
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^26.15.3"
  }
}
